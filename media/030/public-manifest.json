  "priority_listening_windows": [
    {
      "sentence_id": "long-015",
      "text": "Kempton Bunton would later say that a demand for one hundred and forty thousand pounds was meant to support television licences for pensioners.",
      "start_sample": 2444160,
      "end_sample": 2616960,
      "start_seconds": 101.84,
      "end_seconds": 109.04,
      "reason": "Kempton Bunton → Captain Bunton; licences is recognized as licenses here; inspect the spoken name.",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/030-long.html",
      "href": "../../narrated/030-long.html?t=101.84&end=109.04&review=1"
    },
    {
      "sentence_id": "long-018",
      "text": "Bunton's explanation tied the missing painting to pensioners' television costs, bringing an everyday expense into a dispute over a costly public acquisition.",
      "start_sample": 2963520,
      "end_sample": 3163200,
      "start_seconds": 123.48,
      "end_seconds": 131.8,
      "reason": "Bunton's → Budton's; uncommon-name recognition or pronunciation remains uncertain.",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/030-long.html",
      "href": "../../narrated/030-long.html?t=123.48&end=131.8&review=1"
    },
    {
      "sentence_id": "long-019",
      "text": "That stated purpose would become part of the story told around the case, while the criminal proceedings had particular accusations to resolve.",
      "start_sample": 3166080,
      "end_sample": 3360000,
      "start_seconds": 131.92,
      "end_seconds": 140.0,
      "reason": "Transcript inserts Several between criminal and proceedings; inspect for an actual insertion/disfluency, not assumed from ASR alone.",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/030-long.html",
      "href": "../../narrated/030-long.html?t=131.92&end=140&review=1"
    },
    {
      "sentence_id": "long-024",
      "text": "On July nineteenth, nineteen sixty-five, Kempton Bunton surrendered, according to the museum's archive summary of his defence papers.",
      "start_sample": 4079040,
      "end_sample": 4282560,
      "start_seconds": 169.96,
      "end_seconds": 178.44,
      "reason": "Kempton Bunton → Captain Bunton again; consistent ASR name substitution does not establish the spoken word.",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/030-long.html",
      "href": "../../narrated/030-long.html?t=169.96&end=178.44&review=1"
