    {
      "sentence_id": "long-040",
      "text": "A final legal correction came in July two thousand twenty-one, when the Jersey Evening Post reported that Seed's confiscation appeal had succeeded in part.",
      "start_sample": 7265280,
      "end_sample": 7478400,
      "start_seconds": 302.72,
      "end_seconds": 311.6,
      "reason": "2021 date, possible article/disfluency, Chatila and Hatton Garden offences recognition/clarity",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/029-long.html",
      "href": "../../narrated/029-long.html?t=302.72&end=311.6&review=1"
    },
    {
      "sentence_id": "long-029",
      "text": "The overall sentence was ten years, and the identity of Basil had now been tested in a prosecution that ended in conviction.",
      "start_sample": 5170560,
      "end_sample": 5327040,
      "start_seconds": 215.44,
      "end_seconds": 221.96,
      "reason": "2021 date, possible article/disfluency, Chatila and Hatton Garden offences recognition/clarity",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/029-long.html",
      "href": "../../narrated/029-long.html?t=215.44&end=221.96&review=1"
    },
    {
      "sentence_id": "long-030",
      "text": "But the jury acquitted Seed of the separate conspiracy allegation concerning the earlier Chatila burglary, a different case heard at the same trial.",
      "start_sample": 5329920,
      "end_sample": 5520960,
      "start_seconds": 222.08,
      "end_seconds": 230.04,
      "reason": "2021 date, possible article/disfluency, Chatila and Hatton Garden offences recognition/clarity",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/029-long.html",
      "href": "../../narrated/029-long.html?t=222.08&end=230.04&review=1"
    },
    {
      "sentence_id": "long-043",
      "text": "This was a limited correction to confiscation, not an acquittal or the reversal of the ten-year sentence for the Hatton Garden offences.",
      "start_sample": 7868160,
      "end_sample": 8036160,
      "start_seconds": 327.84,
      "end_seconds": 334.84,
      "reason": "2021 date, possible article/disfluency, Chatila and Hatton Garden offences recognition/clarity",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
      "format": "long",
      "player_path": "narrated/029-long.html",
      "href": "../../narrated/029-long.html?t=327.84&end=334.84&review=1"
    },
    {
      "sentence_id": "short-1-004",
      "text": "In March two thousand sixteen, Collins, Jones, Perkins and Lincoln each received seven years; Wood received six.",
      "start_sample": 585600,
      "end_sample": 755520,
      "start_seconds": 24.4,
      "end_seconds": 31.48,
      "reason": "Wood received six / Michael Seed recognition",
      "status": "Listening review required; ASR candidate, not a confirmed defect",
